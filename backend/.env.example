# Database Settings
# For local SQLite development: sqlite:///./codercorps.db
# For production PostgreSQL: postgresql://username:password@hostname:port/dbname
DATABASE_URL=sqlite:///./codercorps.db

# JWT Security
JWT_SECRET=super-secret-key-change-in-production

# CORS Configurations
# Comma-separated allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP Mail Settings (SMTP/Email provider details for notification/password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username-here@gmail.com
SMTP_PASSWORD=your-smtp-password-here
MAIL_TO=alerts@codercorps.com

# Email Provider (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here
FRONTEND_URL=http://localhost:3000

# LLM Question Generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Deployment settings (development | production)
ENVIRONMENT=development

